# Copy to .env and fill in. Never commit the real .env.

# From @BotFather in Telegram
TELEGRAM_BOT_TOKEN=

# OpenAI — used for Whisper voice transcription (STT) + the bot's TTS replies. Also
# backs the OPTIONAL `openai` generation engine. The conversation + outline "brain"
# no longer uses this; it runs on the logged-in `claude` CLI (no API key).
OPENAI_API_KEY=

# DeepSeek V3 — only required if LLM_PROVIDER=deepseek (fallback generation engine only)
DEEPSEEK_API_KEY=

# LLM for the FALLBACK `openai` generation engine only (GENERATION_ENGINE=openai).
# The conversation + outline brain runs on Claude regardless of this setting.
# "openai" (default) -> uses OPENAI_API_KEY + gpt-4o
# "deepseek"         -> uses DEEPSEEK_API_KEY + deepseek-chat
LLM_PROVIDER=openai

# Claude "brain" models for the conversation + outline legs (logged-in claude CLI,
# subscription, no API key). Fast/cheap model for the mechanical interview turns;
# strong model for the taste-heavy outline draft. Use exact aliases, no date suffix.
CONVERSE_MODEL=claude-haiku-4-5
OUTLINE_MODEL=claude-opus-4-8
# Post-delivery refine loop: reads each message after the deck is sent and decides
# whether it's a change to apply, a sign-off, chit-chat, or too vague to act on
# (when unsure it asks rather than trigger a wasted rebuild). Stronger than the
# interview model on purpose (judgment + resolving vague references).
REFINE_MODEL=claude-sonnet-4-6

# REQUIRED: the Telegram user IDs allowed to use the bot. Comma-separated numeric IDs. The bot refuses to start if this is empty
# or has a non-numeric entry — it never runs open to everyone.
# To find your ID, message @userinfobot in Telegram.
ALLOWED_USER_IDS=

# Model overrides (defaults: gpt-4o for openai, deepseek-chat for deepseek)
LLM_MODEL=
WHISPER_MODEL=whisper-1

# Voice mode for incoming voice messages:
#   "translate"  (default) -> Whisper renders any spoken language to English,
#                             so a non-English brief still yields an English deck.
#   "transcribe"           -> keep the spoken language verbatim.
VOICE_MODE=translate

# Deck-generation engine:
#   "claude" (default) -> agentic: Claude Code (Opus) writes -> renders -> looks at
#                         the slides -> fixes, via the voicepptx MCP server. Mimics
#                         the Claude web app. Requires the `claude` CLI on PATH with
#                         a logged-in subscription (no ANTHROPIC_API_KEY needed), plus
#                         soffice + pdftoppm for the visual loop.
#   "openai"           -> one-shot: gpt-4o emits pptxgenjs, rendered once (fallback).
GENERATION_ENGINE=claude
# Path to the Claude Code CLI (default: claude on PATH). Under a service user, point
# this at that user's binary, e.g. ~/.local/bin/claude.
CLAUDE_BIN=claude
# The generation agent always runs with --permission-mode dontAsk, no built-in
# tools except WebSearch/WebFetch in research mode, and only the voicepptx MCP
# server. (GENERATION_PERMISSION_MODE is gone; a value left in .env is ignored.)
#
# Sandbox for the model-written deck script (render_deck):
#   "auto"  (default) -> bubblewrap when it works on this host (no network, homes
#                        hidden, only node_modules + out/ visible); otherwise a
#                        scrubbed env and a warning in the journal.
#   "bwrap"           -> require the sandbox; renders fail without it.
# Needs the `bubblewrap` package. Set "bwrap" once the journal shows no warning.
RENDER_SANDBOX=auto
# Hard per-deck cost cap; the agent aborts if it would exceed this. Research mode
# (below) adds agent turns + network round-trips, so the default is 3.00.
GENERATION_MAX_BUDGET_USD=3.00

# Research-backed citations.
#   RESEARCH_MODE=on (default) -> the deck is research-proof: the outline writes
#     directional claims (no invented figures/entities), and the generation agent
#     grounds every specific in a REAL retrieved source (find_sources -> Semantic
#     Scholar/Crossref, plus a WebSearch/WebFetch fallback) and renders an inline
#     footnote citing it. Never fabricates numbers or citations.
#   RESEARCH_MODE=off -> restores the old "invent plausible specifics for punch"
#     behavior (no sourcing, no footnotes).
RESEARCH_MODE=on
# Max sources find_sources returns per query (bounds research cost). Default 4.
RESEARCH_MAX_SOURCES=4
# How long (ms) Telegraf lets an update handler run before aborting it. The Claude
# generation agent runs inside the handler and takes minutes, so this MUST exceed
# generation time (telegraf's own default is only 90000). Set 0/off to disable.
HANDLER_TIMEOUT_MS=600000

# TTS for bot's voice replies. Voice options: alloy, echo, fable, onyx, nova, shimmer.
TTS_MODEL=tts-1
TTS_VOICE=alloy
